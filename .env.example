# ==============================================================================
# MEETING INTEL - BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Sao chép file này thành .env để cấu hình cục bộ: cp .env.example .env
# Tuyệt đối KHÔNG commit file .env chứa API key thật lên Git!
# ==============================================================================

# --- [BẮT BUỘC KHI CHẠY MÔ HÌNH LLM] ---
# Khóa Google Gemini API dùng để trích xuất dữ liệu từ transcript mới
# Lấy khóa miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=
# Mô hình Gemini chính thức (mặc định: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- [BẢO VỆ & AN TOÀN TRỰC TUYẾN KHI DEPLOY RENDER] ---
# Mã truy cập bảo vệ web demo trực tuyến (để trống nếu chạy local tự do)
# Nếu cấu hình, người dùng cần nhập mã này vào ô khóa trên web trước khi chạy transcript mới
ACCESS_CODE=MeetingIntel2026
# Giới hạn số lượt chạy gọi pipeline API mỗi ngày theo giờ UTC (mặc định: 100)
DAILY_RUN_LIMIT=100
# Giới hạn tần suất request tối đa từ một địa chỉ IP trong 1 phút (mặc định: 30)
RATE_LIMIT_PER_MINUTE=30
# Cổng chạy Web Server (mặc định: 8080 trên local, Render tự động cấp qua $PORT)
PORT=8080
# Địa chỉ IP lắng nghe (mặc định: 127.0.0.1 trên local, Render cần đặt 0.0.0.0)
HOST=127.0.0.1

# --- [TÙY CHỌN: BỘ CHẤM JEV SYSTEM ONE] ---
# Endpoint Jev System One qua OpenCode API
JEV_BASE_URL=https://opencode.ai/inference/v1/systemone
# Khóa OpenCode API (nếu để trống, hệ thống tự động bỏ qua Jev an toàn)
OPENCODE_API_KEY=
# Mô hình Jev (mặc định: jev-1.13-free)
JEV_MODEL=jev-1.13-free

# --- [TÙY CHỌN: MÔ HÌNH ĐỘC LẬP NEMOTRON] ---
# Khóa NVIDIA NIM API (chỉ dùng khi sinh dữ liệu kiểm thử độc lập ngoài tập)
NVIDIA_API_KEY=
